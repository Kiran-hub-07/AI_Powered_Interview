  <p id="loading-text">Generating tailored questions...</p>
</div>
<div class="toast" id="toast-notify"></div>

<script>
(function(){'use strict';

/* ============================================================
   CONFIG + STATE
============================================================ */
const cfg={resume:'',jd:'',role:'',company:'',totalQ:5,timeLimit:120,mode:'text',difficulty:'mid',apiKey:''};
const ses={questions:[],qTypes:[],answers:[],currentIdx:0,timerInt:null,timeLeft:120,fillerCounts:{},totalFillers:0,confidenceScores:[]};
const FILLER_WORDS=['um','uh','like','you know','basically','literally','actually','so','right','okay','kind of','sort of','i mean','honestly','you know what i mean','at the end of the day'];
const WARMUP_QS=['Tell me about yourself in 2 minutes — hit your background, key skills, and why you are here.','What is your biggest professional achievement so far?','Describe a time you dealt with a difficult team member.','How do you handle multiple deadlines at once?','What are you most looking forward to in your next role?'];
let isSpeaking=false,isListening=false,spokenBuf='',speechRec=null,voicesLoaded=false,warmupIdx=0,mouthAnim=null;
const $=id=>document.getElementById(id);

/* ============================================================
   AVATAR ANIMATION
============================================================ */
function setAvatarState(state){
  const face=$('avatar-face'),statusEl=$('avatar-status');
  const mouth=$('mouth-path');
  clearInterval(mouthAnim);
  if(state==='speaking'){
    face.classList.add('speaking');
    statusEl.textContent='Speaking...';
    statusEl.className='avatar-status active';
    let open=false;
    mouthAnim=setInterval(()=>{
      open=!open;
      mouth.setAttribute('d',open?'M 37 61 Q 45 68 53 61':'M 37 61 Q 45 64 53 61');
    },150);
  } else if(state==='listening'){
    face.classList.remove('speaking');
    statusEl.textContent='Listening...';
    statusEl.className='avatar-status active';
    mouth.setAttribute('d','M 38 62 Q 45 63 52 62');
  } else if(state==='thinking'){
    face.classList.remove('speaking');
    statusEl.textContent='Thinking...';
    statusEl.className='avatar-status active';
    mouth.setAttribute('d','M 39 62 L 51 62');
  } else {
    face.classList.remove('speaking');
    statusEl.textContent='Ready';
    statusEl.className='avatar-status';
    mouth.setAttribute('d','M 37 61 Q 45 65 53 61');
  }
}

/* ============================================================
   TTS
============================================================ */
function loadVoices(){
  return new Promise(r=>{
    if(!window.speechSynthesis){r([]);return;}
    let v=window.speechSynthesis.getVoices();
    if(v.length>0){voicesLoaded=true;r(v);return;}
    window.speechSynthesis.onvoiceschanged=()=>{v=window.speechSynthesis.getVoices();voicesLoaded=true;r(v);};
    setTimeout(()=>r(window.speechSynthesis.getVoices()),600);
  });
}
async function speakText(text,onDone){
  if(!window.speechSynthesis){if(onDone)onDone();return;}
  window.speechSynthesis.cancel();
  isSpeaking=true;
  $('ai-speaking-bar').classList.add('active');
  setAvatarState('speaking');
  const utter=new SpeechSynthesisUtterance(text);
  utter.rate=0.93;utter.pitch=1.05;utter.volume=1;
  if(!voicesLoaded)await loadVoices();
  const voices=window.speechSynthesis.getVoices();
  const pref=voices.find(v=>/en-US|en-GB/i.test(v.lang)&&/google|natural|premium|samantha|daniel|karen|moira|zira/i.test(v.name))||voices.find(v=>/en/i.test(v.lang))||voices[0];
  if(pref)utter.voice=pref;
  utter.onend=()=>{isSpeaking=false;$('ai-speaking-bar').classList.remove('active');setAvatarState('ready');clearInterval(mouthAnim);if(onDone)onDone();};
  utter.onerror=()=>{isSpeaking=false;$('ai-speaking-bar').classList.remove('active');setAvatarState('ready');clearInterval(mouthAnim);if(onDone)onDone();};
  window.speechSynthesis.speak(utter);
}
function stopSpeaking(){
  if(window.speechSynthesis)window.speechSynthesis.cancel();
  isSpeaking=false;$('ai-speaking-bar').classList.remove('active');
  setAvatarState('ready');clearInterval(mouthAnim);
}

/* ============================================================
   CLAUDE API
============================================================ */
async function callClaude(systemPrompt,userPrompt,maxTokens=1200){
  if(!cfg.apiKey)throw new Error('No API key');
  const res=await fetch('https://api.anthropic.com/v1/messages',{
    method:'POST',
    headers:{'Content-Type':'application/json','x-api-key':cfg.apiKey,'anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true'},
    body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:maxTokens,system:systemPrompt,messages:[{role:'user',content:userPrompt}]})
  });
  if(!res.ok){const e=await res.json();throw new Error(e.error?.message||'API error '+res.status);}
  const d=await res.json();
  return d.content[0].text;
}

async function generateQuestionsAI(){
  const sys=`You are an expert interviewer generating tailored, insightful interview questions.`;
  const prompt=`Generate exactly ${cfg.totalQ} interview questions for a ${cfg.difficulty}-level ${cfg.role}${cfg.company?' at '+cfg.company:''} candidate.

RESUME SUMMARY:
${cfg.resume.slice(0,2000)}

JOB DESCRIPTION:
${cfg.jd.slice(0,2000)}

Rules:
- Mix: 2 behavioral (STAR-style), ${Math.ceil(cfg.totalQ*0.35)} technical/skills-based, 1 situational, 1 role-fit/motivation
- Reference SPECIFIC skills, tools, or experiences from the resume and JD
- Make each question uniquely tailored — no generic filler
- ${cfg.difficulty==='senior'?'Ask deeper strategic, leadership, and architectural questions.':cfg.difficulty==='entry'?'Focus on fundamentals, learning agility, and potential.':'Balance technical depth with behavioral examples.'}

Return ONLY a JSON array of objects: [{"q":"question text","type":"behavioral|technical|situational|rolefit|experience"}]
No markdown, no explanation, just the JSON array.`;
  const raw=await callClaude(sys,prompt,1600);
  let parsed;
  try{
    const clean=raw.replace(/```json|```/g,'').trim();
    parsed=JSON.parse(clean);
  }catch(e){
    // Fallback: try to extract JSON array
    const match=raw.match(/\[[\s\S]*\]/);
    if(match)parsed=JSON.parse(match[0]);
    else throw new Error('Could not parse questions from AI response');
  }
  return parsed;
}

async function evaluateAnswerAI(question,answer,qType){
  const sys=`You are a strict but fair interview coach evaluating candidate answers. Be honest and constructive.`;
  const prompt=`Evaluate this interview answer for a ${cfg.role} position.

QUESTION (${qType}): ${question}

CANDIDATE'S ANSWER: ${answer}

CONTEXT:
- Resume: ${cfg.resume.slice(0,800)}
- JD requirements: ${cfg.jd.slice(0,600)}

Score on a scale of 0-20 and return ONLY this JSON (no markdown):
{
  "score": <0-20 integer>,
  "feedback": "<2-3 sentences: what was strong, what was missing, one specific improvement tip>",
  "keywords_used": ["word1","word2"],
  "missed_keywords": ["word1","word2"]
}`;
  const raw=await callClaude(sys,prompt,400);
  const clean=raw.replace(/```json|```/g,'').trim();
  return JSON.parse(clean);
}

async function generateOverallFeedbackAI(breakdown,finalScore){
  const sys=`You are a senior interview coach writing a detailed, personalized evaluation.`;
  const answersStr=breakdown.map((b,i)=>`Q${i+1}[${b.type}](score:${b.score}/20): "${b.candidate_answer.slice(0,200)}"`).join('\n');
  const prompt=`Write a 3-paragraph overall interview evaluation for a ${cfg.role} candidate who scored ${finalScore}/100.

Their Q&A performance:
${answersStr}

Para 1: Overall performance summary (strengths)
Para 2: Key areas for improvement with specific advice
Para 3: Next steps / preparation tips

Keep it direct, constructive, and actionable. No fluff.`;
  return await callClaude(sys,prompt,600);
}

/* ============================================================
   FILLER WORD DETECTION
============================================================ */
function detectFillers(text){
  const lower=text.toLowerCase();
  const found={};
  FILLER_WORDS.forEach(f=>{
    const regex=new RegExp('\\b'+f+'\\b','gi');
    const matches=lower.match(regex);
    if(matches){found[f]=(found[f]||0)+matches.length;}
  });
  return found;
}
function updateFillerUI(newFillers){
  Object.entries(newFillers).forEach(([w,c])=>{ses.fillerCounts[w]=(ses.fillerCounts[w]||0)+c;ses.totalFillers+=c;});
  const chips=$('filler-chips');
  chips.innerHTML='';
  if(Object.keys(ses.fillerCounts).length===0){chips.innerHTML='<span class="filler-chip clean">None detected</span>';return;}
  Object.entries(ses.fillerCounts).sort((a,b)=>b[1]-a[1]).slice(0,6).forEach(([w,c])=>{
    const ch=document.createElement('span');
    ch.className='filler-chip';ch.textContent=`"${w}" ×${c}`;chips.appendChild(ch);
  });
}
function highlightFillers(text){
  let h=escapeHTML(text);
  FILLER_WORDS.forEach(f=>{
    const regex=new RegExp('\\b('+f+')\\b','gi');
    h=h.replace(regex,'<span class="filler-word">$1</span>');
  });
  return h;
}
function updateConfidence(answer){
  const words=answer.trim().split(/\s+/).length;
  const fillerRatio=ses.totalFillers/(ses.answers.length*10||1);
  const avgWords=ses.answers.reduce((a,b)=>a+(b.candidate_answer||'').split(/\s+/).length,0)/(ses.answers.length||1);
  let score=Math.min(100,Math.round(
    (Math.min(avgWords/150,1)*40)+
    (Math.max(0,1-fillerRatio*2)*30)+
    (ses.confidenceScores.reduce((a,b)=>a+b,0)/(ses.confidenceScores.length||1)||50)*0.3
  ));
  ses.confidenceScores.push(score);
  $('confidence-pct').textContent=score+'%';
  $('confidence-bar').style.width=score+'%';
  const tip=score>=75?'Strong delivery — keep using specific examples.'
    :score>=50?'Good effort. Reduce filler words and add more structure.'
    :'Focus on STAR method and remove hesitation words.';
  $('confidence-tip').textContent=tip;
}

