                <circle id="right-pupil" cx="59" cy="37" r="4" fill="#0a1628" style="animation:eyeMove 4s ease-in-out infinite;"/>
                <!-- Iris -->
                <circle cx="31" cy="37" r="2.5" fill="#00c8f8" opacity=".8"/>
                <circle cx="59" cy="37" r="2.5" fill="#00c8f8" opacity=".8"/>
                <!-- Eye shine -->
