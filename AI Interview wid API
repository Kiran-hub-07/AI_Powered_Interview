                <ellipse id="right-lid" cx="59" cy="37" rx="7" ry="6" fill="#0d2044" style="transform-origin:59px 37px;animation:blink 4s ease-in-out infinite 0.05s;"/>
                <!-- Eyebrows -->
                <path d="M 24 28 Q 31 25 38 28" stroke="#6890c0" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <path d="M 52 28 Q 59 25 66 28" stroke="#6890c0" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <!-- Nose -->
                <path d="M 45 43 L 42 51 Q 45 53 48 51 Z" fill="#0f2a52" opacity=".6"/>
                <!-- Mouth (animated when speaking) -->
                <path id="mouth-path" d="M 37 61 Q 45 65 53 61" stroke="#4a7ab5" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <!-- Tech circuit lines on face -->
                <line x1="2" y1="38" x2="18" y2="38" stroke="rgba(0,200,248,.2)" stroke-width="1"/>
                <line x1="72" y1="38" x2="88" y2="38" stroke="rgba(0,200,248,.2)" stroke-width="1"/>
                <circle cx="18" cy="38" r="2" fill="rgba(0,200,248,.3)"/>
                <circle cx="72" cy="38" r="2" fill="rgba(0,200,248,.3)"/>
