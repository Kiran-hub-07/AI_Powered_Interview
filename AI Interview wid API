/* ============================================================
   EVALUATION
============================================================ */
async function compileResults(){
  showLoading(true,'AI is evaluating your responses — this takes a moment...');
  setAvatarState('thinking');
  try{
    // Evaluate each answer
    const breakdown=[];
    for(const entry of ses.answers){
      try{
        const eval_res=await evaluateAnswerAI(entry.question,entry.candidate_answer,entry.type);
        breakdown.push({...entry,...eval_res});
      }catch(e){
        // Fallback local scoring if API fails
        const local=localScore(entry.candidate_answer,entry.type);
        breakdown.push({...entry,...local});
      }
    }
    const count=ses.answers.length;
    const totalScore=Math.round(breakdown.reduce((a,b)=>a+b.score,0)/count/20*100);
    const alignment=Math.round(breakdown.reduce((a,b)=>a+b.score,0)/count/20*100);
    const depth=Math.round(ses.answers.reduce((a,b)=>a+(b.candidate_answer||'').split(/\s+/).length,0)/count/150*100);
    const structure=Math.round(breakdown.filter(b=>b.score>=12).length/count*100);
    const clarity=Math.min(100,Math.round((1-ses.totalFillers/Math.max(ses.answers.reduce((a,b)=>a+(b.candidate_answer||'').split(/\s+/).length,0),1)*0.3)*100));
    // Overall feedback from AI
    let overallFeedback='';
    try{overallFeedback=await generateOverallFeedbackAI(breakdown,totalScore);}
    catch(e){overallFeedback=localOverallFeedback(totalScore);}
    // Render
    renderResults(totalScore,alignment,Math.min(100,depth),structure,Math.max(0,clarity),breakdown,overallFeedback,count);
  }catch(err){
    showLoading(false);showToast('Evaluation error: '+err.message);console.error(err);
  }
}

function localScore(answer,type){
  const a=answer.toLowerCase().trim();
  if(a.length<20||a==='no response.'||a==='no audio captured.')return{score:0,feedback:'No response provided.'};
  let s=Math.min(5,Math.floor(a.length/100));
  const star=['situation','task','action','result','example','achieved','resolved'];
  s+=Math.min(5,star.filter(w=>a.includes(w)).length);
  s=Math.min(20,s+7);
  return{score:s,feedback:'Good attempt. Add more specific examples and quantifiable results.',keywords_used:[],missed_keywords:[]};
}
function localOverallFeedback(score){
  if(score>=70)return'Strong performance overall. Your answers showed relevant experience and good structure. Focus on quantifying your achievements further.';
  if(score>=45)return'Decent effort with room to grow. Prepare more detailed STAR-method stories and tie each answer back to the job requirements.';
  return'Your responses need more depth and specificity. Practice with the STAR method, remove filler words, and study the job description carefully before your next interview.';
}

function renderResults(total,alignment,depth,structure,clarity,breakdown,feedback,count){
  $('final-score-big').textContent=total;
  const circ=440;$('results-ring-fill').style.strokeDashoffset=circ-(circ*total/100);
  const badge=$('readiness-badge');
  if(total>=70){badge.className='readiness-label rl-strong';badge.textContent='Strong Candidate';}
  else if(total>=45){badge.className='readiness-label rl-mid';badge.textContent='Developing Candidate';}
  else{badge.className='readiness-label rl-improve';badge.textContent='Needs Preparation';}
  const setDim=(v,b,val)=>{$(v).textContent=val+'%';$(b).style.width=val+'%';};
  setDim('dim-alignment-val','dim-alignment-bar',alignment);
  setDim('dim-relevancy-val','dim-relevancy-bar',depth);
  setDim('dim-depth-val','dim-depth-bar',structure);
  setDim('dim-clarity-val','dim-clarity-bar',clarity);
  // Stats
  const avgWords=Math.round(ses.answers.reduce((a,b)=>a+(b.candidate_answer||'').split(/\s+/).length,0)/(ses.answers.length||1));
  const bestQ=breakdown.reduce((a,b)=>b.score>a.score?b:a,breakdown[0]);
  $('stat-questions').textContent=count;
  $('stat-avg-len').textContent=avgWords;
  $('stat-fillers').textContent=ses.totalFillers;
  $('stat-best-q').textContent=(bestQ?.score||0)+'/20';
  $('final-feedback-text').textContent=feedback;
  const list=$('qa-breakdown-list');list.innerHTML='';
  breakdown.forEach((item,i)=>{
    const meta=TYPE_META[item.type]||TYPE_META.technical;
    const col=item.score>=14?'var(--accent3)':item.score>=8?'var(--warn)':'var(--danger)';
    const card=document.createElement('div');card.className='qa-item';
    card.innerHTML=`<div class="qa-top">
      <div class="qa-q"><span class="score-tag" style="background:${meta.bg};color:${meta.color}">${meta.label}</span>Q${i+1}: ${escapeHTML(item.question)}</div>
      <div class="qa-score" style="color:${col}">${item.score}<span style="font-size:12px;color:var(--text3)">/20</span></div>
    </div>
    <div class="qa-a"><strong>Your Answer:</strong> ${highlightFillers(item.candidate_answer)}</div>
    <div class="qa-fb">💬 ${escapeHTML(item.feedback||'')}</div>`;
    list.appendChild(card);
  });
  showLoading(false);showScreen('results-screen');
  setAvatarState('ready');
  if(cfg.mode!=='text'){
    const summary=total>=70?`Great job! You scored ${total} out of 100.`:total>=45?`You scored ${total} out of 100. Solid effort with room to grow.`:`You scored ${total} out of 100. Focus on specific examples and structure.`;
    setTimeout(()=>speakText(summary),700);
  }
}

/* ============================================================
   UTILITIES
============================================================ */
function escapeHTML(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML;}
function showLoading(show,msg='Processing...'){$('loading-text').textContent=msg;$('loading-layer').classList.toggle('active',show);}
function showToast(msg){const t=$('toast-notify');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),4500);}
function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));$(id).classList.add('active');}

$('restart-btn').addEventListener('click',()=>{
  clearInterval(ses.timerInt);stopVoice();stopSpeaking();
  Object.assign(ses,{questions:[],qTypes:[],answers:[],currentIdx:0,timerInt:null,timeLeft:120,fillerCounts:{},totalFillers:0,confidenceScores:[]});
  spokenBuf='';
  $('answer-input').value='';$('char-count').textContent='0 chars';
  setAvatarState('ready');
  showScreen('setup-screen');
});

loadVoices();
})();
</script>
</body>
</html>
