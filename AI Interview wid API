<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>AI Interview Studio</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#07090f;--surface:#0d1220;--surface2:#111827;--border:#1a2540;
  --accent:#00c8f8;--accent2:#6d28d9;--accent3:#10b981;
  --warn:#f59e0b;--danger:#ef4444;
  --text:#e2e8f0;--text2:#94a3b8;--text3:#475569;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:radial-gradient(ellipse 80% 60% at 50% -20%,rgba(0,200,248,.08),transparent);pointer-events:none;z-index:0;}
body::after{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(0,200,248,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,200,248,.025) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;}
.screen{display:none;position:relative;z-index:1;}
.screen.active{display:block;}

/* ===== SETUP ===== */
#setup-screen{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;}
#setup-screen.active{display:flex;}
.logo{font-family:'Syne',sans-serif;font-size:12px;font-weight:700;letter-spacing:6px;text-transform:uppercase;color:var(--accent);margin-bottom:44px;opacity:0;animation:fadeUp .6s forwards .1s;}
.hero-title{font-family:'Syne',sans-serif;font-size:clamp(2rem,5vw,3.6rem);font-weight:800;text-align:center;line-height:1.12;margin-bottom:14px;opacity:0;animation:fadeUp .6s forwards .25s;}
.hero-title span{background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hero-sub{font-size:15px;color:var(--text2);text-align:center;max-width:460px;line-height:1.7;margin-bottom:44px;opacity:0;animation:fadeUp .6s forwards .4s;}
.setup-card{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:36px;width:100%;max-width:680px;opacity:0;animation:fadeUp .6s forwards .55s;}
.setup-card h3{font-family:'Syne',sans-serif;font-size:11px;font-weight:700;letter-spacing:4px;text-transform:uppercase;color:var(--accent);margin-bottom:26px;}
.field{margin-bottom:22px;}
.field label{display:block;font-size:11px;font-weight:500;color:var(--text2);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:9px;}
.field textarea,.field input,.field select{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:13px 15px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;resize:vertical;transition:border-color .2s,box-shadow .2s;outline:none;}
.field textarea:focus,.field input:focus,.field select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,200,248,.07);}
.field textarea{min-height:100px;}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;}
.resume-tabs{display:flex;gap:0;margin-bottom:10px;border:1px solid var(--border);border-radius:10px;overflow:hidden;}
.resume-tab{flex:1;padding:10px;background:transparent;border:none;color:var(--text2);font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer;transition:background .2s,color .2s;}
.resume-tab.active{background:var(--accent);color:#000;font-weight:600;}
#resume-upload-area{display:none;border:2px dashed var(--border);border-radius:10px;padding:28px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s;}
#resume-upload-area:hover{border-color:var(--accent);background:rgba(0,200,248,.03);}
#resume-upload-area .upload-icon{font-size:30px;margin-bottom:8px;}
#resume-upload-area p{font-size:13px;color:var(--text2);}
#resume-upload-area .file-chosen{font-size:12px;color:var(--accent);margin-top:6px;}
#resume-file{display:none;}
.btn-primary{width:100%;padding:17px;background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;border-radius:12px;font-family:'Syne',sans-serif;font-size:15px;font-weight:700;letter-spacing:.5px;color:#fff;cursor:pointer;margin-top:8px;transition:opacity .2s,transform .15s,box-shadow .2s;}
.btn-primary:hover{opacity:.9;transform:translateY(-1px);box-shadow:0 8px 30px rgba(0,200,248,.2);}
.btn-primary:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none;}
.warmup-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.25);color:var(--warn);border-radius:100px;padding:4px 12px;font-size:11px;font-weight:600;margin-bottom:16px;cursor:pointer;transition:background .2s;}
.warmup-badge:hover{background:rgba(245,158,11,.2);}

/* ===== MODE MODAL ===== */
#mode-modal{display:none;position:fixed;inset:0;background:rgba(7,9,15,.92);backdrop-filter:blur(16px);z-index:200;align-items:center;justify-content:center;}
#mode-modal.active{display:flex;}
.mode-box{background:var(--surface);border:1px solid var(--border);border-radius:24px;padding:44px 40px;max-width:640px;width:94%;text-align:center;}
.mode-box h2{font-family:'Syne',sans-serif;font-size:24px;font-weight:800;margin-bottom:8px;}
.mode-box p{color:var(--text2);font-size:14px;margin-bottom:32px;line-height:1.65;}
.mode-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;}
.mode-card{background:var(--bg);border:2px solid var(--border);border-radius:16px;padding:24px 16px;cursor:pointer;transition:border-color .2s,transform .15s,box-shadow .2s;text-align:center;}
.mode-card:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,200,248,.12);}
.mode-card .mode-icon{font-size:36px;margin-bottom:12px;}
.mode-card h3{font-family:'Syne',sans-serif;font-size:14px;font-weight:700;margin-bottom:6px;}
.mode-card p{font-size:12px;color:var(--text2);line-height:1.5;}

/* ===== WARMUP MODAL ===== */
#warmup-modal{display:none;position:fixed;inset:0;background:rgba(7,9,15,.92);backdrop-filter:blur(16px);z-index:200;align-items:center;justify-content:center;}
#warmup-modal.active{display:flex;}
.warmup-box{background:var(--surface);border:1px solid var(--border);border-radius:24px;padding:40px;max-width:560px;width:94%;text-align:center;}
.warmup-box h2{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;margin-bottom:8px;}
.warmup-box p{color:var(--text2);font-size:14px;margin-bottom:28px;line-height:1.65;}
.warmup-q{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:20px;font-size:15px;line-height:1.6;}
.warmup-controls{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
.warmup-btn{padding:10px 20px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text2);font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer;transition:all .2s;}
.warmup-btn:hover{border-color:var(--accent);color:var(--accent);}
.warmup-btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;color:#fff;font-weight:600;}

/* ===== INTERVIEW ===== */
#interview-screen{min-height:100vh;padding:0;}
#interview-screen.active{display:flex;flex-direction:column;}
.interview-header{display:flex;align-items:center;justify-content:space-between;padding:14px 28px;background:var(--surface);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:50;}
.interview-header .logo-sm{font-family:'Syne',sans-serif;font-size:11px;font-weight:700;letter-spacing:4px;color:var(--accent);text-transform:uppercase;}
.hdr-meta{display:flex;align-items:center;gap:18px;}
.q-counter{font-family:'DM Mono',monospace;font-size:12px;color:var(--text2);}
.timer-wrap{display:flex;align-items:center;gap:8px;font-family:'DM Mono',monospace;}
.timer-dot{width:7px;height:7px;border-radius:50%;background:var(--accent3);animation:pulse 1.2s infinite;}
.timer-dot.warn{background:var(--warn);}
.timer-dot.danger{background:var(--danger);}
#timer-display{font-size:18px;font-weight:500;color:var(--text);}
.skip-btn{padding:6px 14px;background:transparent;border:1px solid var(--border);border-radius:8px;color:var(--text3);font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer;transition:all .2s;}
.skip-btn:hover{border-color:var(--warn);color:var(--warn);}

.interview-body{flex:1;display:grid;grid-template-columns:280px 1fr 260px;min-height:0;}
@media(max-width:900px){.interview-body{grid-template-columns:1fr;}.sidebar,.notes-panel{display:none;}}
@media(min-width:901px) and (max-width:1100px){.interview-body{grid-template-columns:240px 1fr;}.notes-panel{display:none;}}

/* ===== LEFT SIDEBAR ===== */
.sidebar{background:var(--surface);border-right:1px solid var(--border);padding:22px;overflow-y:auto;display:flex;flex-direction:column;gap:20px;}
.sidebar-section h4{font-family:'Syne',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:10px;}
.progress-bar-wrap{background:var(--bg);border-radius:4px;height:6px;overflow:hidden;}
.progress-bar{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .7s ease;}
.mode-badge{padding:4px 12px;border-radius:100px;font-family:'DM Mono',monospace;font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:1px;background:rgba(109,40,217,.15);color:#a78bfa;border:1px solid rgba(109,40,217,.3);}
.q-history{display:flex;flex-direction:column;gap:6px;max-height:280px;overflow-y:auto;}
.q-hist-item{display:flex;align-items:center;gap:8px;padding:7px 10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;font-size:12px;}
.q-hist-item .num{font-family:'DM Mono',monospace;color:var(--text3);min-width:18px;}
.q-hist-item .qt{color:var(--text2);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.q-hist-item.done .num{color:var(--accent3);}

/* ===== CONFIDENCE TRACKER ===== */
.confidence-section{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px;}
.confidence-label{display:flex;justify-content:space-between;font-size:12px;color:var(--text2);margin-bottom:8px;}
.confidence-bar-bg{background:var(--border);border-radius:4px;height:8px;overflow:hidden;margin-bottom:8px;}
.confidence-bar{height:100%;border-radius:4px;background:linear-gradient(90deg,#ef4444,#f59e0b,#10b981);width:0%;transition:width .8s ease;}
.confidence-tip{font-size:11px;color:var(--text3);line-height:1.5;}

/* ===== FILLER WORD TRACKER ===== */
.filler-section{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px;}
.filler-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;}
.filler-chip{padding:3px 8px;border-radius:100px;font-size:10px;font-family:'DM Mono',monospace;background:rgba(239,68,68,.12);color:var(--danger);border:1px solid rgba(239,68,68,.2);}
.filler-chip.clean{background:rgba(16,185,129,.1);color:var(--accent3);border-color:rgba(16,185,129,.2);}

/* ===== AI AVATAR ===== */
.avatar-panel{display:flex;flex-direction:column;align-items:center;gap:10px;padding:16px 0;}
.avatar-container{position:relative;width:90px;height:90px;}
.avatar-face{width:90px;height:90px;border-radius:50%;background:linear-gradient(135deg,#0a1628,#0d2044);border:2px solid var(--border);overflow:hidden;position:relative;transition:border-color .3s;}
.avatar-face.speaking{border-color:var(--accent);box-shadow:0 0 0 4px rgba(0,200,248,.15),0 0 20px rgba(0,200,248,.1);}
.avatar-face svg{width:100%;height:100%;}
.avatar-rings{position:absolute;inset:-8px;border-radius:50%;pointer-events:none;}
.avatar-rings span{position:absolute;inset:0;border-radius:50%;border:1px solid rgba(0,200,248,.3);animation:ringPulse 2s ease-out infinite;opacity:0;}
.avatar-rings span:nth-child(2){animation-delay:.6s;}
.avatar-rings span:nth-child(3){animation-delay:1.2s;}
.avatar-face.speaking .avatar-rings span{opacity:1;}
.avatar-name{font-family:'Syne',sans-serif;font-size:12px;font-weight:700;color:var(--text);}
.avatar-status{font-size:11px;color:var(--text3);font-family:'DM Mono',monospace;}
.avatar-status.active{color:var(--accent);}

/* ===== AI SPEAKING BAR ===== */
.ai-speaking-bar{display:none;align-items:center;gap:10px;padding:10px 16px;background:rgba(0,200,248,.06);border:1px solid rgba(0,200,248,.15);border-radius:10px;margin-bottom:12px;}
.ai-speaking-bar.active{display:flex;}
.ai-speaking-bar .speak-label{font-size:12px;color:var(--accent);font-family:'DM Mono',monospace;}
.speak-waves{display:flex;align-items:center;gap:3px;height:18px;}
.speak-waves span{display:inline-block;width:3px;border-radius:2px;background:var(--accent);animation:wave .8s ease-in-out infinite;}
.speak-waves span:nth-child(1){animation-delay:0s;}
.speak-waves span:nth-child(2){animation-delay:.1s;}
.speak-waves span:nth-child(3){animation-delay:.2s;}
.speak-waves span:nth-child(4){animation-delay:.3s;}
.speak-waves span:nth-child(5){animation-delay:.4s;}

/* ===== MAIN PANEL ===== */
.main-panel{display:flex;flex-direction:column;background:var(--bg);overflow:hidden;}
.chat-area{flex:1;overflow-y:auto;padding:24px 28px;display:flex;flex-direction:column;gap:18px;}
.msg{display:flex;gap:12px;align-items:flex-start;opacity:0;animation:fadeUp .4s forwards;}
.msg.user{flex-direction:row-reverse;}
.av{width:36px;height:36px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;}
.av.ai-av{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-family:'Syne',sans-serif;}
.av.user-av{background:var(--surface2);border:1px solid var(--border);color:var(--text2);font-family:'Syne',sans-serif;}
.bubble{max-width:76%;padding:14px 16px;border-radius:14px;font-size:14px;line-height:1.75;}
.msg.ai .bubble{background:var(--surface);border:1px solid var(--border);border-top-left-radius:4px;}
.msg.user .bubble{background:linear-gradient(135deg,rgba(0,200,248,.1),rgba(109,40,217,.1));border:1px solid rgba(0,200,248,.18);border-top-right-radius:4px;}
.q-type-tag{display:inline-block;margin-bottom:7px;padding:2px 10px;border-radius:100px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:1px;}

/* ===== FILLER HIGHLIGHT ===== */
.filler-word{background:rgba(239,68,68,.2);color:var(--danger);border-radius:3px;padding:0 2px;}

/* ===== INPUT AREA ===== */
.input-area{padding:16px 28px 20px;background:var(--surface);border-top:1px solid var(--border);}
.input-wrap{display:flex;gap:10px;align-items:flex-end;}
#answer-input{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:13px 15px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;resize:none;outline:none;min-height:50px;max-height:140px;transition:border-color .2s;line-height:1.6;}
#answer-input:focus{border-color:var(--accent);}
.send-btn{width:50px;height:50px;border-radius:12px;flex-shrink:0;background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:opacity .2s,transform .15s;}
.send-btn:hover{opacity:.85;transform:scale(1.04);}
.send-btn svg{width:18px;height:18px;fill:white;}
.mic-btn{width:50px;height:50px;border-radius:50%;border:2px solid var(--border);background:var(--bg);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;}
.mic-btn:disabled{opacity:.4;cursor:not-allowed;}
.mic-btn.listening{background:rgba(239,68,68,.15);border-color:var(--danger);box-shadow:0 0 0 4px rgba(239,68,68,.1);animation:micRing 1s infinite;}
.mic-btn svg{width:22px;height:22px;fill:var(--text2);}
.mic-btn.listening svg{fill:var(--danger);}
.voice-status{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 16px;font-size:13px;color:var(--text2);min-height:50px;display:flex;align-items:center;gap:10px;}
.input-hint{font-size:11px;color:var(--text3);margin-top:8px;display:flex;justify-content:space-between;}
.voice-submit-btn{padding:0 18px;height:50px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;color:#fff;font-family:'Syne',sans-serif;font-size:12px;font-weight:700;cursor:pointer;letter-spacing:.5px;white-space:nowrap;display:none;}

/* ===== RIGHT PANEL: NOTES ===== */
.notes-panel{background:var(--surface);border-left:1px solid var(--border);padding:22px;display:flex;flex-direction:column;gap:18px;overflow-y:auto;}
.notes-panel h4{font-family:'Syne',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:0;}
.notes-area{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px;resize:none;font-family:'DM Sans',sans-serif;font-size:13px;color:var(--text2);outline:none;min-height:140px;line-height:1.65;}
.notes-area:focus{border-color:var(--text3);}
.note-hint{font-size:11px;color:var(--text3);line-height:1.5;}
.key-point-list{display:flex;flex-direction:column;gap:6px;}
.key-point-item{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:var(--text2);line-height:1.5;padding:8px 10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;}
.key-point-item::before{content:"→";color:var(--accent);flex-shrink:0;margin-top:1px;}

/* ===== RESULTS ===== */
#results-screen{min-height:100vh;padding:0 0 80px;}
.results-inner{max-width:920px;margin:0 auto;padding:50px 24px;}
.results-header{text-align:center;margin-bottom:48px;}
.results-header .tag{font-family:'Syne',sans-serif;font-size:11px;font-weight:700;letter-spacing:5px;text-transform:uppercase;color:var(--accent);margin-bottom:12px;}
.results-header h1{font-family:'Syne',sans-serif;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:800;margin-bottom:6px;}
.score-hero{display:grid;grid-template-columns:210px 1fr;gap:28px;margin-bottom:30px;}
@media(max-width:600px){.score-hero{grid-template-columns:1fr;}}
.readiness-ring-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:30px 20px;}
.readiness-ring{width:160px;height:160px;position:relative;margin-bottom:14px;}
.readiness-ring svg{transform:rotate(-90deg);}
.readiness-ring .ring-track{fill:none;stroke:var(--border);stroke-width:10;}
.readiness-ring .ring-fill{fill:none;stroke:url(#ringGrad);stroke-width:10;stroke-linecap:round;stroke-dasharray:440;stroke-dashoffset:440;transition:stroke-dashoffset 1.8s ease;}
.ring-label{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.ring-label .big{font-family:'Syne',sans-serif;font-size:42px;font-weight:800;}
.ring-label .small{font-size:13px;color:var(--text3);}
.readiness-label{font-family:'Syne',sans-serif;font-size:12px;font-weight:700;padding:5px 16px;border-radius:100px;}
.rl-strong{background:rgba(16,185,129,.15);color:var(--accent3);border:1px solid rgba(16,185,129,.3);}
.rl-mid{background:rgba(245,158,11,.15);color:var(--warn);border:1px solid rgba(245,158,11,.3);}
.rl-improve{background:rgba(239,68,68,.15);color:var(--danger);border:1px solid rgba(239,68,68,.3);}
.dim-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.dim-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px;}
.dim-card .dim-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;}
.dim-card .dim-name{font-size:12px;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;}
.dim-card .dim-val{font-family:'DM Mono',monospace;font-size:22px;}
.dim-bar-bg{background:var(--bg);border-radius:4px;height:6px;overflow:hidden;}
.dim-bar{height:100%;border-radius:4px;transition:width 1.2s ease;}
.feedback-block{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:28px;margin-bottom:24px;}
.feedback-block h4{font-family:'Syne',sans-serif;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:16px;}
#final-feedback-text{font-size:14px;line-height:1.9;color:var(--text2);}
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:24px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px 14px;text-align:center;}
.stat-val{font-family:'Syne',sans-serif;font-size:26px;font-weight:800;display:block;margin-bottom:4px;}
.stat-label{font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.5px;}
.qa-breakdown{margin-top:20px;}
.qa-breakdown h4{font-family:'Syne',sans-serif;font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--text3);margin-bottom:14px;}
.qa-item{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px;margin-bottom:12px;}
.qa-item .qa-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;gap:12px;}
.qa-item .qa-q{font-size:13px;font-weight:500;flex:1;line-height:1.5;}
.qa-item .qa-score{font-family:'DM Mono',monospace;font-size:26px;font-weight:700;white-space:nowrap;}
.qa-item .qa-a{font-size:12px;color:var(--text2);padding:10px 14px;background:var(--bg);border-radius:10px;margin-bottom:10px;line-height:1.65;}
.qa-item .qa-fb{font-size:12px;color:var(--text3);font-style:italic;line-height:1.65;padding-left:8px;border-left:2px solid var(--border);}
.score-tag{display:inline-block;font-size:10px;font-weight:700;padding:2px 9px;border-radius:100px;margin-right:6px;text-transform:uppercase;letter-spacing:.5px;}
.restart-btn{display:block;width:100%;padding:17px;background:linear-gradient(135deg,var(--accent),var(--accent2));border:none;border-radius:12px;font-family:'Syne',sans-serif;font-size:15px;font-weight:700;color:#fff;cursor:pointer;margin-top:28px;transition:opacity .2s,transform .15s;}
.restart-btn:hover{opacity:.9;transform:translateY(-1px);}
.loading-overlay{display:none;position:fixed;inset:0;background:rgba(7,9,15,.9);backdrop-filter:blur(12px);z-index:300;align-items:center;justify-content:center;flex-direction:column;gap:20px;}
.loading-overlay.active{display:flex;}
.spinner{width:46px;height:46px;border-radius:50%;border:3px solid var(--border);border-top-color:var(--accent);animation:spin .7s linear infinite;}
.loading-overlay p{color:var(--text2);font-size:14px;}
.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(100px);background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 20px;font-size:13px;z-index:400;transition:transform .3s ease;max-width:380px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,.4);}
.toast.show{transform:translateX(-50%) translateY(0);}
.api-key-notice{background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);border-radius:10px;padding:12px 16px;font-size:12px;color:var(--warn);margin-top:16px;line-height:1.6;}

/* ===== AI AVATAR SVG ANIMATION ===== */
@keyframes blink{0%,90%,100%{transform:scaleY(1)}95%{transform:scaleY(.05)}}
@keyframes mouthTalk{0%,100%{d:path("M 38 58 Q 45 62 52 58")}50%{d:path("M 38 58 Q 45 66 52 58")}}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes ringPulse{0%{transform:scale(1);opacity:.5}100%{transform:scale(1.5);opacity:0}}
@keyframes micRing{0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,.4)}50%{box-shadow:0 0 0 10px rgba(239,68,68,0)}}
@keyframes wave{0%,100%{height:4px}50%{height:20px}}
@keyframes eyeMove{0%,100%{transform:translateX(0)}50%{transform:translateX(1px)}}
</style>
</head>
<body>

<!-- SETUP SCREEN -->
<div id="setup-screen" class="screen active">
  <div class="logo">AI Interview Studio</div>
  <h1 class="hero-title"><span>AI-Powered</span><br/>Interview Studio</h1>
