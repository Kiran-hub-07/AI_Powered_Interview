          <option value="mid" selected>Mid Level</option>
          <option value="senior">Senior / Lead</option>
        </select>
      </div>
    </div>

    <div style="text-align:center;margin-bottom:4px;">
      <button class="warmup-badge" id="warmup-btn-setup">💪 Warm-up Mode — Practice before your real session</button>
    </div>
    <button class="btn-primary" id="open-modes-btn">Select Interview Mode →</button>
  </div>
</div>

<!-- MODE MODAL -->
<div id="mode-modal">
  <div class="mode-box">
    <h2>Choose Your Interview Mode</h2>
    <p>Text mode is silent. Voice modes have the AI interviewer <strong>speak every question aloud</strong> via an animated avatar for a realistic experience.</p>
    <div class="mode-cards">
      <div class="mode-card" data-mode="text">
        <div class="mode-icon">⌨️</div>
        <h3>Text Interview</h3>
        <p>Read questions, type your answers. Silent & focused.</p>
      </div>
      <div class="mode-card" data-mode="voice-text">
        <div class="mode-icon">🎙️</div>
        <h3>Voice + Typing</h3>
        <p>AI speaks the question aloud. You speak or type, then submit.</p>
      </div>
      <div class="mode-card" data-mode="voice-speaking">
        <div class="mode-icon">🗣️</div>
        <h3>Full Voice</h3>
